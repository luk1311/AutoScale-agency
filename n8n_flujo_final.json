{
  "name": "AutoScale Leads Final Flow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nuevo-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook (Supabase INSERT)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [200, 300],
      "webhookId": "autoscale-nuevo-lead"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.body.record.correo }}",
        "subject": "=¡Hola {{ $json.body.record.nombre }}! Recibimos tu solicitud 🚀",
        "message": "=Hola {{ $json.body.record.nombre }},\n\n¡Gracias por escribirnos! Hemos recibido tu solicitud para el servicio de \"{{ $json.body.record.servicio }}\".\n\nNuestro equipo está revisando tu información y nos pondremos en contacto contigo por WhatsApp en breve para darte todos los detalles.\n\n¡Hablemos pronto!\nEl equipo de AutoScale Agency.",
        "additionalFields": {}
      },
      "id": "2",
      "name": "Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v17.0/YOUR_PHONE_NUMBER_ID/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_ACCESS_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $('Webhook (Supabase INSERT)').item.json.body.record.whatsapp }}"
            },
            {
              "name": "type",
              "value": "template"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "WhatsApp API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "leads",
        "matchType": "anyCondition",
        "matchConditions": {
          "conditions": [
            {
              "key": "id",
              "condition": "equals",
              "value": "={{ $('Webhook (Supabase INSERT)').item.json.body.record.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "contactado"
            }
          ]
        }
      },
      "id": "4",
      "name": "Update a row",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Webhook (Supabase INSERT)": {
      "main": [
        [
          {
            "node": "Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail": {
      "main": [
        [
          {
            "node": "WhatsApp API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp API": {
      "main": [
        [
          {
            "node": "Update a row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  }
}
