# URL del webhook del orquestador (n8n / Make / Zapier) que recibe los leads
# del formulario de contacto y dispara las automatizaciones:
#   1. Guardar el lead (Google Sheets / Airtable / DB)
#   2. Enviar email automático de bienvenida al cliente
#   3. Enviar mensaje por WhatsApp API (WhatsApp Cloud API / Twilio)
#
# Copia este archivo a `.env.local` y reemplaza el valor por tu webhook real.
# IMPORTANTE: las variables expuestas al navegador DEBEN llevar el prefijo VITE_.
VITE_LEAD_WEBHOOK_URL=https://tu-orquestador.example.com/webhook/leads
