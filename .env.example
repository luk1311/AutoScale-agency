# ============================================================================
# AutoScale — Variables de entorno (frontend)
# Flujo único: el frontend SOLO habla con Supabase. Las automatizaciones
# (email + WhatsApp) las dispara un Database Webhook de Supabase hacia n8n,
# NO el navegador. Por eso aquí ya no hay URL de webhook ni contraseña de admin.
# Copia este archivo a `.env.local` y reemplaza con tus valores reales.
# Recuerda: todo lo expuesto al navegador DEBE llevar el prefijo VITE_.
# ============================================================================

# Supabase (la anon key es pública por diseño; la seguridad real la da RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# El acceso al CRM (/admin) usa Supabase Auth. Crea el usuario admin en:
#   Dashboard -> Authentication -> Users -> Add user
# (Ya NO se usa VITE_ADMIN_PASSWORD: una contrasena en el bundle no protege nada.)
